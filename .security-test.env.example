# Temporary disposable accounts only. Copy to .security-test.env.
# Before running, explicitly set PARSITASKS_LIVE_TEST_ACCOUNTS=1 in the shell.
PARSITASKS_TEST_A_EMAIL=first-test-account@example.com
PARSITASKS_TEST_A_PASSWORD=replace-me
PARSITASKS_TEST_B_EMAIL=second-test-account@example.com
PARSITASKS_TEST_B_PASSWORD=replace-me

# The live test only writes this harmless proof task if cross-account RLS is broken.
PARSITASKS_SECURITY_PROOF_WRITE=0
