{
  "name": "rhythm-day",
  "version": "0.26.6",
  "private": true,
  "description": "Parsitasks — личное пространство для задач, времени и прогресса",
  "main": "desktop/main.cjs",
  "engines": {
    "node": ">=24.11.1"
  },
  "scripts": {
    "desktop": "electron .",
    "desktop:smoke": "electron . --smoke-test",
    "test:e2e": "node tests/electron-e2e.cjs && node tests/timeline-journal-interactions-e2e.cjs && node tests/menu-popovers-e2e.cjs && node tests/accessibility-e2e.cjs",
    "lint": "node tests/lint.cjs",
    "test": "node tests/run-tests.cjs",
    "test:security-live": "node tests/security-live.cjs",
    "test:sync-live": "node tests/remote-sync-live.cjs",
    "capture:landing": "node scripts/capture-landing-product.cjs",
    "generate:icons": "node scripts/generate-icons.cjs",
    "build:web": "node scripts/build-web.cjs",
    "build:worker": "wrangler deploy --dry-run --outdir .wrangler-build",
    "build:cloudflare": "npm test && npm run lint && npm run build:web && npm run build:worker",
    "mcp:dev": "npm run build:web && wrangler dev",
    "build:win": "electron-builder --win portable nsis --publish never",
    "pack:win": "electron-builder --win portable --publish never",
    "release:win": "electron-builder --win portable nsis --publish always"
  },
  "repository": "github:Pars1fal0/tasks-and-habits",
  "build": {
    "appId": "local.rhythm-day.tracker",
    "productName": "Parsitasks",
    "directories": {
      "output": "dist"
    },
    "files": [
      "app/**/*",
      "CHANGELOG.md",
      "desktop/**/*",
      "README.md",
      "database/supabase-schema.sql"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "allowToChangeInstallationDirectory": true,
      "oneClick": false,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "ParsiTasks-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "ParsiTasks-Portable-${version}-${arch}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "Pars1fal0",
      "repo": "tasks-and-habits",
      "releaseType": "release"
    }
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@supabase/supabase-js": "^2.110.7",
    "agents": "^0.17.4",
    "axe-core": "^4.12.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "playwright-core": "^1.61.1",
    "sharp": "^0.35.2",
    "wrangler": "^4.114.0",
    "zod": "^4.4.3"
  },
  "overrides": {
    "@hono/node-server": "2.0.11",
    "brace-expansion": "5.0.9"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
